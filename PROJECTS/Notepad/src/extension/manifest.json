{
  "manifest_version": 3,
  "name": "Classic Notepad",
  "version": "0.1.0",
  "description": "A Notepad-like plain text editor inside a Chrome extension popup.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Open Classic Notepad",
    "default_popup": "popup.html"
  },
  "commands": {
    "open_notepad": {
      "suggested_key": {
        "default": "Ctrl+Shift+N"
      },
      "description": "Open Classic Notepad popup"
    }
  },
  "icons": {
    "16": "pnp.png",
    "48": "pnp.png",
    "128": "pnp.png"
  }
}
