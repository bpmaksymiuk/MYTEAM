{
  "manifest_version": 3,
  "name": "Notepad",
  "version": "0.0.6",
  "description": "Notepad-style Chrome extension window.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Notepad"
  },
  "commands": {
    "open-notepad-window": {
      "suggested_key": {
        "default": "Ctrl+Shift+N"
      },
      "description": "Open Notepad window"
    }
  }
}
