{
  "manifest_version": 3,
  "name": "Browser Buddy",
  "version": "0.6.1",
  "description": "Browser Buddy side panel for notes, favorites, capture, and reusable clipboard workflows.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel",
    "clipboardWrite",
    "bookmarks"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Browser Buddy"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
