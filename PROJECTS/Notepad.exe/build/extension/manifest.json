{
  "manifest_version": 3,
  "name": "Notepad.exe",
  "version": "1.0",
  "description": "A standalone Notepad window styled like Windows Notepad.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Notepad"
  },
  "permissions": ["storage", "windows"]
}
